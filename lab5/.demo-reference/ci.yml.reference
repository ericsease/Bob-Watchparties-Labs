name: Lab 5 — Inventory Service CI

# Scoped to lab5/ changes only — won't fire on other labs
on:
  push:
    branches: [main, lab-5]
    paths:
      - 'lab5/service/**'
  pull_request:
    branches: [main]
    paths:
      - 'lab5/service/**'

jobs:
  # ── Job 1: Build & Test ──────────────────────────────────────────────────────
  build-and-test:
    name: Build and Test (Java 17)
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: maven

      - name: Build with Maven
        working-directory: lab5/service
        run: mvn -B package --no-transfer-progress

      - name: Run tests
        working-directory: lab5/service
        run: mvn -B test --no-transfer-progress

      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-results
          path: lab5/service/target/surefire-reports/

  # ── Job 2: Security Scan ─────────────────────────────────────────────────────
  secret-scan:
    name: Secret Scan
    runs-on: ubuntu-latest
    needs: build-and-test

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Scan for hardcoded secrets
        # Mirrors the Bob hook — two layers of protection
        run: |
          echo "Scanning for hardcoded credentials..."
          if grep -rniE "password=|passwd=|secret=|api_key=|apikey=" \
               --include="*.properties" \
               --include="*.yaml" \
               --include="*.yml" \
               --exclude-dir=".git" \
               lab5/service/; then
            echo "❌ Hardcoded credentials found — failing build"
            exit 1
          fi
          echo "✅ No hardcoded credentials found"

  # ── Job 3: Docker Build ───────────────────────────────────────────────────────
  docker-build:
    name: Docker Build (Java 17 image)
    runs-on: ubuntu-latest
    needs: build-and-test

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build Docker image
        uses: docker/build-push-action@v5
        with:
          context: lab5/service
          push: false
          tags: inventory-service:${{ github.sha }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
